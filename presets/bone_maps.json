{
  "_about": [
    "Naming conventions for gtr.auto_map_bones.",
    "Templates use {s} (and {S} for MMD suffix forms) for the side token of sided slots.",
    "Candidates are tried in order; for 'chest' the first one is the humanoid chest (SAO mounts the guitar on MMD 上半身2, which it maps to VRM chest) and later ones are fallbacks that raise a warning.",
    "'strip' is a regex removed from the normalised (NFKC, case-folded) bone names before matching; 'requires' lists names that must exist for the convention to apply.",
    "'generic' lists name endings for rigs that match no convention; the longest matching ending wins."
  ],
  "conventions": [
    {
      "id": "VROID",
      "label": "VRoid / VRM (J_Bip)",
      "sides": {"L": {"s": "L"}, "R": {"s": "R"}},
      "slots": {
        "hips": ["J_Bip_C_Hips"],
        "chest": ["J_Bip_C_Chest", "J_Bip_C_UpperChest", "J_Bip_C_Spine"],
        "neck": ["J_Bip_C_Neck"],
        "head": ["J_Bip_C_Head"],
        "thigh": ["J_Bip_{s}_UpperLeg"],
        "upper_arm": ["J_Bip_{s}_UpperArm"],
        "forearm": ["J_Bip_{s}_LowerArm"],
        "hand": ["J_Bip_{s}_Hand"],
        "index_proximal": ["J_Bip_{s}_Index1"],
        "index_intermediate": ["J_Bip_{s}_Index2"],
        "index_distal": ["J_Bip_{s}_Index3"],
        "middle_proximal": ["J_Bip_{s}_Middle1"],
        "middle_intermediate": ["J_Bip_{s}_Middle2"],
        "middle_distal": ["J_Bip_{s}_Middle3"],
        "ring_proximal": ["J_Bip_{s}_Ring1"],
        "ring_intermediate": ["J_Bip_{s}_Ring2"],
        "ring_distal": ["J_Bip_{s}_Ring3"]
      }
    },
    {
      "id": "MIXAMO",
      "label": "Mixamo",
      "strip": "^mixamorig\\d*[:_]",
      "sides": {"L": {"s": "Left"}, "R": {"s": "Right"}},
      "slots": {
        "hips": ["Hips"],
        "chest": ["Spine1", "Spine2", "Spine"],
