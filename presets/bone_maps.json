        "index_intermediate": ["{s}HandIndex2"],
        "index_distal": ["{s}HandIndex3"],
        "middle_proximal": ["{s}HandMiddle1"],
        "middle_intermediate": ["{s}HandMiddle2"],
        "middle_distal": ["{s}HandMiddle3"],
        "ring_proximal": ["{s}HandRing1"],
        "ring_intermediate": ["{s}HandRing2"],
        "ring_distal": ["{s}HandRing3"]
      }
    },
